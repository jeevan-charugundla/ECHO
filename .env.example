# ==============================================================================
# ECHO — Multimodal Evidence Intelligence Engine Environment Configuration
# ==============================================================================

# Gemini API Key (stored ONLY in backend environment, never exposed to client)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemma 4 Model ID options supported:
# - gemma-4-26b-a4b-it (Mixture of Experts: 25.2B total, 3.8B active, multimodal, default)
# - gemma-4-31b-it     (Dense 30.7B multimodal reasoning model)
GEMMA_MODEL_ID=gemma-4-26b-a4b-it

# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
